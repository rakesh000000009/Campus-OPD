# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication Secret
JWT_SECRET=campus-opd-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Database Configuration
# Optional: If DATABASE_URL is left empty or unset, the backend automatically uses
# embedded PostgreSQL (PGlite) stored locally in database/pgdata/ (zero setup required).
# For external PostgreSQL or Docker Compose:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_opd
DATABASE_URL=
PG_DATA_DIR=./database/pgdata
